{
  "manifest_version": 3,
  "name": "T68k Authenticator",
  "version": "1.0.0",
  "description": "Sleek, private, and secure two-factor authentication manager with graphical countdowns and instant QR scanning.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Open T68k Authenticator"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "T68k Authenticator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "t68k-authenticator@local",
      "strict_min_version": "109.0"
    }
  }
}